# Generate a random token with: openssl rand -hex 24
BRIDGE_TOKEN=CHANGE_ME_TO_A_RANDOM_SECRET
BRAIN_HOST=127.0.0.1
BRAIN_PORT=3197
MEMORY_PATH=./data/memory.json
# Separate provider credentials: TypeSafe for Jev decisions; OpenAI for GPT-6 Luna chat.
TYPESAFE_API_KEY=
OPENAI_API_KEY=
AHMET_DECISION_MODE=jev
AHMET_CHAT_MODE=llm
# Default launch selection is jev-preview; an explicit valid process environment override wins.
JEV_MODEL=jev-preview
CHAT_MODEL=gpt-6-luna
